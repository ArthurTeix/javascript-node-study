<!-- Esse arquivo é como um html mas com recursos especiais -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Estudos de implementação</title>
</head>

<body>
    <section class="container">
        <h5>
            <%= titulo %> <!-- Com o sinal de =, ele me traz exatamente o que tem (mais fiel) -->
            <br>     
            <%- titulo %> <!-- Com o sinal de -, ele me executa o código html presente -->
        </h5>

        <h6>
            <!-- Quando não tiver nenhum sinal, é apenas controle de fluxo -->
            <% if (typeof mensagem !== 'undefined') {%>
                <%= mensagem %>
            <% } else { %>
                <%= "Nenhuma mensagem encontrada" %>
            <% } %>
        </h6>

        <h6>    
            <%for (let value of numeros) {%>
                <%=value%>
            <%}%>
        </h6>

        <form action="/" method="post">
            <label>Nome:</label>
            <input type="text" name="cliente">
            <button>Submit</button>
        </form>
    </section>

    <script src="./assets/js/bundle.js"></script>
</body>

</html>